{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fishy Client",
  "version": "2.0.1",
  "identifier": "com.fishyclient.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Fishy Client",
        "width": 1200,
        "height": 760,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Fishy Client",
    "copyright": "Fishy Client contributors. Licensed under GPL-3.0-or-later.",
    "license": "GPL-3.0-or-later",
    "homepage": "https://github.com/Gnammahh/fishy-client",
    "category": "Game",
    "shortDescription": "A fish-themed launcher for your Epic Games library",
    "longDescription": "Fishy Client is an open-source launcher for the games you own on Epic Games: sign in, install, update and play them.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "wix": {
        "language": "en-US",
        "upgradeCode": "d895a25e-2ca5-44d4-b204-1ee4cb3b89f9"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY2NkIxRDZCMzUzODlDMjUKUldRbG5EZzFheDFyWnRsclc2OGZwcE90U0xXbmFZWlJ0bFFLL1dLOUxkeW0zN2FDcmgxM2k0VzYK",
      "endpoints": [
        "https://github.com/Gnammahh/fishy-client/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
